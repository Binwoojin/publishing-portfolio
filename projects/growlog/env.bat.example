@echo off
REM 로컬 백엔드 실행용 환경변수 템플릿 (Windows cmd 버전)
REM
REM 사용법:
REM   1. 이 파일을 env.bat로 복사한다 (env.bat는 .gitignore에 등록되어 있어 커밋되지 않는다)
REM        copy env.bat.example env.bat
REM   2. env.bat를 열어 실제 값(비밀번호 등)으로 채운다.
REM   3. 백엔드를 실행하기 전에 같은 cmd 창에서 실행한다 (더블클릭 금지, 반드시 같은 창에서 실행).
REM        env.bat
REM        mvn spring-boot:run
REM
REM 주의: 더블클릭으로 실행하면 새 창이 뜨고 그 창만 닫히면서 끝나버려
REM 지금 쓰고 있는 cmd 창에는 환경변수가 남지 않는다. 반드시 지금 열려있는
REM cmd 창에서 "env.bat"라고 직접 입력해서 실행해야 한다.

set DB_USERNAME=growlog_admin
set DB_PASSWORD=여기에_실제_RDS_비밀번호
set MAIL_USERNAME=fammegirls0123@gmail.com
set MAIL_PASSWORD=여기에_실제_Gmail_앱_비밀번호

REM Vue 개발 서버가 아닌 다른 Origin에서 접근해야 할 경우에만 필요 (기본값: http://localhost:5173)
REM set CORS_ALLOWED_ORIGINS=http://localhost:5173

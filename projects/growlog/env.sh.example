#!/usr/bin/env bash
#
# 로컬 백엔드 실행용 환경변수 템플릿.
#
# 사용법:
#   1. 이 파일을 env.sh로 복사한다 (env.sh는 .gitignore에 등록되어 있어 커밋되지 않는다)
#        cp env.sh.example env.sh
#   2. env.sh를 열어 실제 값(비밀번호 등)으로 채운다.
#   3. 백엔드를 실행하기 전에 source로 불러온다.
#        source env.sh
#        mvn spring-boot:run
#
# 주의: Spring Boot는 Node/Vite와 달리 .env 파일을 자동으로 읽지 않는다.
# 반드시 source로 셸에 값을 export한 뒤에 mvn을 실행해야 한다.

export DB_USERNAME=growlog_admin
export DB_PASSWORD=여기에_실제_RDS_비밀번호
export MAIL_USERNAME=fammegirls0123@gmail.com
export MAIL_PASSWORD=여기에_실제_Gmail_앱_비밀번호

# Vue 개발 서버가 아닌 다른 Origin에서 접근해야 할 경우에만 필요 (기본값: http://localhost:5173)
# export CORS_ALLOWED_ORIGINS=http://localhost:5173
